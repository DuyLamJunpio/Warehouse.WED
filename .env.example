APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require

CACHE_DRIVER=file
FILESYSTEM_DISK=r2
# Cloudflare R2 (S3-compatible). R2_ENDPOINT là endpoint API; R2_PUBLIC_URL
# là custom domain public đã gắn vào bucket (ví dụ https://media.example.com).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=thebasicconcept
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.example.com

QUEUE_CONNECTION=sync
# Render xoá sạch ổ đĩa mỗi lần deploy hoặc khởi động lại, nên driver "file" làm
# bay hết phiên đang mở - tab đang mở bấm Lưu sẽ nhận "CSRF token mismatch".
# Driver "cookie" giữ phiên ngay trong cookie đã mã hoá: sống sót qua deploy và
# không tốn thêm truy vấn tới Supabase (mỗi truy vấn ~320ms).
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Bí mật dùng chung với web bán hàng. Sinh bằng: php -r "echo bin2hex(random_bytes(32));"
STOREFRONT_WEBHOOK_SECRET=

# Địa chỉ web bán hàng (Next.js). Dùng để báo nó làm mới catalogue ngay khi lưu
# sản phẩm — bí mật ở trên phải khớp WAREHOUSE_WEBHOOK_SECRET bên đó.
STOREFRONT_URL=http://localhost:3000
