APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require

CACHE_DRIVER=file
FILESYSTEM_DISK=supabase
# Supabase Storage (giao thức S3). ENDPOINT dùng để tải file lên, PUBLIC_URL để
# sinh link cho trình duyệt - hai địa chỉ khác nhau, đừng điền nhầm.
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=ap-south-1
SUPABASE_BUCKET=warehouse
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/warehouse

QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Bí mật dùng chung với web bán hàng. Sinh bằng: php -r "echo bin2hex(random_bytes(32));"
STOREFRONT_WEBHOOK_SECRET=

# Địa chỉ web bán hàng (Next.js). Dùng để báo nó làm mới catalogue ngay khi lưu
# sản phẩm — bí mật ở trên phải khớp WAREHOUSE_WEBHOOK_SECRET bên đó.
STOREFRONT_URL=http://localhost:3000
